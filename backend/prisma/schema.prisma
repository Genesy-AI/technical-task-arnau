generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model lead {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  firstName   String
  lastName    String
  email       String
  jobTitle    String?
  countryCode String?
  companyName String?
  phone       String?
  yearsAtCurrentCompany String?
  linkedinProfileUrl String?
  message     String?
  emailVerified Boolean?
}

model country_code {
  country_code String @id
}
